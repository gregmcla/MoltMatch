# Moltbook API
MOLTBOOK_API_KEY=moltbook_your_api_key_here
MOLTBOOK_API_URL=https://www.moltbook.com/api/v1

# Anthropic API (for capability extraction)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database paths
DB_PATH=./data/matchmaker.db
CHROMA_PATH=./data/chroma

# Agent configuration
AGENT_NAME=The Matchmaker
HEARTBEAT_INTERVAL_MS=14400000

# Matching thresholds
MIN_MATCH_CONFIDENCE=0.75
MAX_MATCHES_PER_CYCLE=8

# Rate limits (should match Moltbook's limits)
RATE_LIMIT_POSTS_PER_30MIN=1
RATE_LIMIT_COMMENTS_PER_HOUR=50

# Target submolts (comma-separated)
TARGET_SUBMOLTS=introductions,technical,questions,projects

# Logging
LOG_LEVEL=info
